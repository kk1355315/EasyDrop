# 服务路径。附带的快捷指令固定使用 /drop，通常不要修改。
BASE_PATH=/drop

# 【必须修改】完整公网地址，结尾必须包含 /drop，不能带末尾斜杠。
PUBLIC_BASE_URL=https://drop.example.com/drop

# 【必须修改】PWA 登录密码。建议使用 32 位以上随机字符串。
LOGIN_PASSWORD=replace-with-a-long-password

# 【必须修改】Cookie 签名密钥。可用 openssl rand -hex 32 生成。
SESSION_SECRET=replace-with-random-hex

# 【必须修改】iPad 快捷指令访问令牌。可用 openssl rand -hex 24 生成。
PULL_TOKEN=replace-with-random-hex

# 可选：单个文件最大字节数，默认 2 GiB。
MAX_FILE_BYTES=2147483648

# 可选：未接收文件保留时间。
RETENTION_HOURS=48

# 【必须修改】发信邮箱的 SMTP 设置。请从邮箱服务商处获取。
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SSL=true
SMTP_USER=sender@example.com
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=sender@example.com

# 【必须修改】iPad 上接收触发邮件的地址。
TRIGGER_TO=receiver@example.com

# 可选：必须与 iPad 邮件自动化中填写的主题一致。
TRIGGER_SUBJECT=DROP_READY
